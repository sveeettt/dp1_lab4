#!/usr/bin/env python3
import sys
import termios
import tty
import select

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist

# Базовые скорости (теперь они будут меняться)
speed = 0.5
turn = 1.0

msg = """
Управление TurtleBot3:
---------------------------
   W (вперед)
   S (назад)
   A (влево)
   D (вправо)
   Q (увеличить скорость)
   E (уменьшить скорость)
   CTRL-C для выхода
"""

def getKey():
    tty.setraw(sys.stdin.fileno())
    rlist, _, _ = select.select([sys.stdin], [], [], 0.1)
    if rlist:
        key = sys.stdin.read(1)
    else:
        key = ''
    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)
    return key

class TeleopNode(Node):
    def __init__(self):
        super().__init__('teleop_keyboard')
        self.pub = self.create_publisher(Twist, '/cmd_vel', 1)
        print(msg)

    def run(self):
        global speed, turn
        x = 0.0
        th = 0.0

        try:
            while rclpy.ok():
                rclpy.spin_once(self, timeout_sec=0.01)
                key = getKey()

                if key == 'w' or key == 'W':
                    x = speed
                    th = 0.0
                elif key == 's' or key == 'S':
                    x = -speed
                    th = 0.0
                elif key == 'a' or key == 'A':
                    x = 0.0
                    th = turn
                elif key == 'd' or key == 'D':
                    x = 0.0
                    th = -turn
                elif key == 'q' or key == 'Q':
                    speed *= 1.1
                    turn *= 1.1
                    print(f"Скорость увеличена: linear={speed:.2f}, angular={turn:.2f}")
                elif key == 'e' or key == 'E':
                    speed *= 0.9
                    turn *= 0.9
                    print(f"Скорость уменьшена: linear={speed:.2f}, angular={turn:.2f}")
                elif key == '\x03': # Ctrl+C
                    break
                else:
                    x = 0.0
                    th = 0.0

                twist = Twist()
                twist.linear.x = x
                twist.angular.z = th
                self.pub.publish(twist)

        except Exception as e:
            print(e)
        finally:
            twist = Twist()
            twist.linear.x = 0.0
            twist.angular.z = 0.0
            self.pub.publish(twist)
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, settings)

if __name__ == '__main__':
    settings = termios.tcgetattr(sys.stdin)
    rclpy.init()
    node = TeleopNode()
    try:
        node.run()
    finally:
        node.destroy_node()
        rclpy.shutdown()
